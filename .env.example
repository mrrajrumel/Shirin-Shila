# Environment Configuration Template for Shirin Shila Portfolio
# Copy this file to .env.local or set these in your Hostinger environment dashboard

# Application port (default: 3000)
PORT=3000
HOSTNAME=0.0.0.0

# Session Cryptographic Secret Key (Used for HMAC-SHA256 session token signatures)
# Generate a strong random string before deploying to production
ADMIN_SECRET=replace_with_a_secure_random_string_for_production
